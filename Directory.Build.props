<Project>
  <!-- Optional machine-local SDK configuration; intentionally not committed. -->
  <Import Project="SimConnect.Local.props" Condition="Exists('SimConnect.Local.props')" />

  <!--
    Set MSFS_SDK to the MSFS 2024 SDK root, or override SimConnectAssemblyPath
    with the full path to Microsoft.FlightSimulator.SimConnect.dll.
  -->
  <PropertyGroup>
    <SimConnectAssemblyPath Condition="'$(SimConnectAssemblyPath)' == '' and '$(MSFS_SDK)' != ''">$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectAssemblyPath>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(SimConnectAssemblyPath)')">
    <DefineConstants>$(DefineConstants);HAS_SIMCONNECT</DefineConstants>
    <SimConnectNativeLibraryPath Condition="'$(SimConnectNativeLibraryPath)' == ''">$([System.String]::Copy('$(SimConnectAssemblyPath)').Replace('\managed\Microsoft.FlightSimulator.SimConnect.dll', '\SimConnect.dll'))</SimConnectNativeLibraryPath>
  </PropertyGroup>
</Project>

{
  "name": "fly-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first MSFS 2024 telemetry client",
  "type": "commonjs",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "lab:chat": "npm run build && node dist/lab/lab.js",
    "lab:benchmark": "npm run build && node dist/lab/benchmark/benchmark.js",
    "lab:classify": "npm run build && node dist/lab/classification/classification.js",
    "lab:engine": "npm run build && node dist/lab/engine/engine.js",
    "lab:memory": "npm run build && node dist/lab/memory/memory.js",
    "lab:render": "npm run build && node dist/lab/render/render.js",
    "lab:pipeline": "npm run build && node dist/lab/pipeline/pipeline.js"
  },
  "dependencies": {
    "node-simconnect": "^4.2.0",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}

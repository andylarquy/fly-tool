{
  "name": "fly-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first MSFS 2024 telemetry client",
  "type": "commonjs",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && npm start",
    "lab:chat": "npm run build && node dist/lab/chat/run.js",
    "lab:benchmark": "npm run build && node dist/lab/benchmark/run.js",
    "lab:interpreter": "npm run build && node dist/lab/interpreter/run.js",
    "lab:engine": "npm run build && node dist/lab/engine/run.js",
    "lab:taxi": "npm run build && node dist/lab/taxi/run.js",
    "lab:memory": "npm run build && node dist/lab/memory/run.js",
    "lab:renderer": "npm run build && node dist/lab/renderer/run.js"
  },
  "dependencies": {
    "node-simconnect": "^4.2.0",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
